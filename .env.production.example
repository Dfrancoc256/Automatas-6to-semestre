# Copia este archivo como .env.production solo en el VPS. Nunca lo subas a Git.
APP_PORT=5010
ALLOWED_ORIGINS=https://analizador-umg.duckdns.org
APP_PUBLIC_URL=https://analizador-umg.duckdns.org

# PostgreSQL remoto
DB_CONNECTION_STRING="Host=IP_DEL_VPS;Port=5432;Database=automatasAnalizadorLexico;Username=USUARIO_DB;Password=REEMPLAZAR;SSL Mode=Require"

# Mínimo 32 bytes aleatorios. No reutilizar una contraseña.
JWT_SECRET_KEY=REEMPLAZAR_CON_SECRETO_DE_32_BYTES_O_MAS

# reCAPTCHA
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=REEMPLAZAR_CON_SITE_KEY
RECAPTCHA_SECRET_KEY=REEMPLAZAR_CON_SECRET_KEY

# Opcionales: notificaciones
WHATSAPP_BASE_URL=https://URL_DE_TU_EVOLUTION_API
WHATSAPP_API_KEY=REEMPLAZAR_CON_API_KEY
WHATSAPP_INSTANCE_NAME=umg-lenguajes
EMAIL_USERNAME=tu-correo@ejemplo.com
EMAIL_PASSWORD=REEMPLAZAR_CON_PASSWORD_DE_APLICACION
